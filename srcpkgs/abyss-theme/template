# Template file for 'abyss-theme'
# Abyss desktop look for GTK apps (Thunar, pavucontrol, arandr, ...):
#   GTK 3 theme "Abyss" (Adwaita dark + Abyss purple), icon theme "Abyss"
#   (Papirus-Dark with violet folders), system-wide GTK defaults.
pkgname=abyss-theme
version=1.0
revision=1
depends="papirus-icon-theme xdg-user-dirs"
short_desc="Abyss Linux dark GTK theme and violet folder icons"
maintainer="MrZaKaRiA <67268825+MrZaKaRiA@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/MrZaKaRiA/AbyssLinux"
conf_files="/etc/xdg/gtk-3.0/settings.ini /etc/xdg/gtk-4.0/settings.ini"

do_install() {
	vinstall ${FILESDIR}/index.theme 644 usr/share/themes/Abyss
	vinstall ${FILESDIR}/gtk-3.0/gtk.css 644 usr/share/themes/Abyss/gtk-3.0

	# icon theme: inherits Papirus-Dark, folders point at Papirus' violet set
	vinstall ${FILESDIR}/icons-index.theme 644 usr/share/icons/Abyss index.theme
	while read -r size generic target; do
		case "$size" in ""|\#*) continue ;; esac
		vmkdir usr/share/icons/Abyss/${size}/places
		ln -sf ../../../Papirus/${size}/places/${target} \
			${DESTDIR}/usr/share/icons/Abyss/${size}/places/${generic}
	done < ${FILESDIR}/violet-folders.list

	# system-wide GTK defaults (each user's ~/.config/gtk-*/settings.ini wins)
	vinstall ${FILESDIR}/settings.ini 644 etc/xdg/gtk-3.0
	vmkdir etc/xdg/gtk-4.0
	printf '[Settings]\ngtk-application-prefer-dark-theme=1\ngtk-icon-theme-name=Abyss\n' \
		> ${DESTDIR}/etc/xdg/gtk-4.0/settings.ini
}
