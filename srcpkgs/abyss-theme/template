# Template file for 'abyss-theme'
# Abyss desktop look for GTK apps (Thunar, pavucontrol, arandr, ...):
#   GTK 3 theme "Abyss" (Adwaita dark + Abyss purple), icon theme "Abyss"
#   (Papirus-Dark with violet folders), system-wide GTK defaults, and the
#   extra Abyss wallpapers in /usr/share/backgrounds/abyss ("Abyss Orbit",
#   rendered by files/backgrounds/make-abyss-orbit.py, which is not installed).
pkgname=abyss-theme
version=1.0
revision=7
# abyss-desktop>=1.0_36: its abyss-display-setup makes the login screen's
# background (/var/lib/abyss-greeter/background, see lightdm-gtk-greeter.conf)
depends="papirus-icon-theme xdg-user-dirs font-inter abyss-desktop>=1.0_36"
short_desc="Abyss Linux dark GTK theme and violet folder icons"
maintainer="MrZaKaRiA <67268825+MrZaKaRiA@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/MrZaKaRiA/AbyssLinux"
conf_files="/etc/xdg/gtk-3.0/settings.ini /etc/xdg/gtk-4.0/settings.ini /etc/lightdm/lightdm-gtk-greeter.conf.d/50-abyss.conf"

do_install() {
	vinstall ${FILESDIR}/index.theme 644 usr/share/themes/Abyss
	vinstall ${FILESDIR}/gtk-3.0/gtk.css 644 usr/share/themes/Abyss/gtk-3.0

	# icon theme: inherits Papirus-Dark, folders point at Papirus' violet set
	vinstall ${FILESDIR}/icons-index.theme 644 usr/share/icons/Abyss index.theme
	while read -r size generic target; do
		case "$size" in ""|\#*) continue ;; esac
		vmkdir usr/share/icons/Abyss/${size}/places
		ln -sf ../../../Papirus/${size}/places/${target} \
			${DESTDIR}/usr/share/icons/Abyss/${size}/places/${generic}
	done < ${FILESDIR}/violet-folders.list

	# system-wide GTK defaults (each user's ~/.config/gtk-*/settings.ini wins)
	vinstall ${FILESDIR}/settings.ini 644 etc/xdg/gtk-3.0
	vmkdir etc/xdg/gtk-4.0
	printf '[Settings]\ngtk-application-prefer-dark-theme=1\ngtk-icon-theme-name=Abyss\n' \
		> ${DESTDIR}/etc/xdg/gtk-4.0/settings.ini

	# The greeter owns its main config; shipped defaults belong in its config.d.
	vinstall ${FILESDIR}/lightdm-gtk-greeter.conf 644 etc/lightdm/lightdm-gtk-greeter.conf.d 50-abyss.conf

	# Wallpapers. The default abyss-wallpaper.jpg is ISO-only and must never
	# be packaged. (abyss-splash.png, the old galaxy boot picture, is gone from
	# new images; older installs keep their unowned copy, which nothing uses
	# once abyss-boot has moved /etc/default/grub over.)
	vinstall ${FILESDIR}/backgrounds/abyss-orbit.jpg 644 usr/share/backgrounds/abyss
}
