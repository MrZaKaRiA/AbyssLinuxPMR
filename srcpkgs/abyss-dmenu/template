# Template file for 'abyss-dmenu'
# dmenu 5.4 + upstream git 8627d0c + Abyss patches (patches/):
#   center (-c), border (-bw), line height (-h), password (-P),
#   case-insensitive matching by default, Abyss palette and font
pkgname=abyss-dmenu
version=5.4
revision=1
_gitrev=8627d0c
wrksrc="dmenu-${version}"
makedepends="libXinerama-devel libXft-devel freetype-devel"
short_desc="Generic menu for X (Abyss Linux build)"
maintainer="MrZaKaRiA <67268825+MrZaKaRiA@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/MrZaKaRiA/AbyssLinux"
distfiles="https://dl.suckless.org/tools/dmenu-${version}.tar.gz"
checksum=8fbace2a0847aa80fe861066b118252dcc7b4ca0a0a8f3a93af02da8fb6cd453
conflicts="dmenu>=0"

post_patch() {
	sed -i -e '/CFLAGS/{s/-Os//;s/=/+=/}' \
		-e '/LDFLAGS/{s/-s//;s/=/+=/}' config.mk
}

do_build() {
	sed -i -e "s|^FREETYPEINC|#FREETYPEINC|g" \
		-e "s|^X11INC|#X11INC|g" \
		-e "s|^X11LIB|#X11LIB|g" config.mk
	make CC="$CC" ${makejobs} X11INC=$XBPS_CROSS_BASE/usr/include/X11 \
		X11LIB=$XBPS_CROSS_BASE/usr/lib FREETYPEINC=$XBPS_CROSS_BASE/usr/include/freetype2
}

do_install() {
	make PREFIX=/usr DESTDIR=${DESTDIR} install
	vlicense LICENSE
}
