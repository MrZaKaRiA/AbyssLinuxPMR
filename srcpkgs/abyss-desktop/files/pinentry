#!/bin/sh
# GnuPG's passphrase window on Abyss: the pinentry-program that the Passwords
# menu (abyss-bar) puts in ~/.gnupg/gpg-agent.conf. pinentry-gtk-2 is a GTK 2
# program: it cannot use the GTK 3 Abyss theme and would be light, so it gets
# the Abyss dark GTK 2 colours. The user's own ~/.gtkrc-2.0 (or GTK2_RC_FILES)
# is read after them and still wins. Without pinentry-gtk-2, Void's pinentry.
rc=${ABYSS_GTK2_RC:-/usr/share/abyss/gtk-2.0/gtkrc}
GTK2_RC_FILES="$rc:${GTK2_RC_FILES:-$HOME/.gtkrc-2.0}"
export GTK2_RC_FILES
gtk=${ABYSS_PINENTRY_GTK:-/usr/bin/pinentry-gtk-2}
[ -x "$gtk" ] || gtk=${ABYSS_PINENTRY_FALLBACK:-/usr/bin/pinentry}
exec "$gtk" "$@"
