# Template file for 'abyss-desktop'
# Abyss desktop menus and lightweight helpers, updated through the signed PMR.
pkgname=abyss-desktop
version=1.0
revision=41
makedepends="libX11-devel"
# chrony: time synchronisation (INSTALL enables chronyd once per system)
# xkb-switch: the status bar's keyboard menu switches layouts with it
# (synthetic Alt+Shift presses do not reach XKB's group switch)
# abyss-boot: the Abyss logo from GRUB to the login screen (so updated systems
# get the clean start too)
depends="abyss-st abyss-dmenu abyss-slock>=1.7_2 nsxiv feh xss-lock adwaita-icon-theme xmenu xdotool chrony xkb-switch abyss-boot"
short_desc="Abyss desktop menus, software installer, and hardware setup tools"
maintainer="MrZaKaRiA <67268825+MrZaKaRiA@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/MrZaKaRiA/AbyssLinux"
do_build() {
	$CC $CFLAGS -o abyss-key-capture ${FILESDIR}/abyss-key-capture.c $LDFLAGS -lX11
}
do_install() {
	vmkdir usr/bin
	vinstall abyss-key-capture 755 usr/bin
	for f in ${FILESDIR}/bin/*; do
		[ -f "$f" ] || continue
		vinstall "$f" 755 usr/bin
	done
	# Writes the /usr/local/bin wrappers (INSTALL, and the ISO build)
	vinstall ${FILESDIR}/local-bin-wrappers 755 usr/libexec/abyss-desktop
	# Disk upkeep: cleans the package cache after installs and upgrades, and
	# runs the abyss-fstrim service (weekly TRIM; INSTALL enables it once)
	vinstall ${FILESDIR}/disk-care 755 usr/libexec/abyss-desktop
	vsv abyss-fstrim
	# PipeWire for each desktop session: abyss-session starts it fresh at
	# login and ends it at logout
	vinstall ${FILESDIR}/session-audio 755 usr/libexec/abyss-desktop
	vinstall ${FILESDIR}/abyss-images.desktop 644 usr/share/applications
	# GnuPG's passphrase window (the Passwords menu's pinentry-program):
	# pinentry-gtk-2 with Abyss dark GTK 2 colours
	vinstall ${FILESDIR}/pinentry 755 usr/libexec/abyss-desktop
	vmkdir usr/share/abyss/gtk-2.0
	vinstall ${FILESDIR}/gtk2-dark.gtkrc 644 usr/share/abyss/gtk-2.0 gtkrc
	# Interactive shell helpers (update, upgrade, install, ...). Not a
	# conf_file on purpose: it is code that every update must be able to fix;
	# local changes belong in ~/.bashrc. INSTALL migrates the old copy.
	vinstall ${FILESDIR}/zz-abyss-cli.sh 644 etc/profile.d
	# its bash-only part (pkg-ui, the prompt): /etc/profile runs profile.d
	# in dash and busybox sh too, which cannot parse it
	vinstall ${FILESDIR}/abyss-cli.bash 644 usr/share/abyss

	vmkdir usr/share/abyss/rofi
	vinstall ${FILESDIR}/rofi-config.rasi 644 usr/share/abyss/rofi config.rasi
	# chronyd reads it through /etc/sv/chronyd/conf (written by INSTALL);
	# it includes Void's /etc/chrony.conf and lets chronyd step the clock
	vinstall ${FILESDIR}/chrony.conf 644 usr/share/abyss

	# The current /etc/skel login files of the Abyss image. abyss-session
	# puts them in place of a user's unedited copy of an older version (and
	# starts this .xinitrc for a user who has none).
	vmkdir usr/share/abyss/skel/.dwm
	vinstall ${FILESDIR}/skel/xinitrc 755 usr/share/abyss/skel .xinitrc
	vinstall ${FILESDIR}/skel/autostart.sh 755 usr/share/abyss/skel/.dwm autostart.sh
	# feh for edited pre-27.3.3 login files only (see abyss-session)
	vmkdir usr/libexec/abyss-desktop/legacy
	vinstall ${FILESDIR}/legacy-feh 755 usr/libexec/abyss-desktop/legacy feh
}

