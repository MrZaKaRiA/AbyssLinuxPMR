# Template file for 'abyss-desktop'
# Abyss desktop menus and lightweight helpers, updated through the signed PMR.
pkgname=abyss-desktop
version=1.0
revision=31
makedepends="libX11-devel"
# chrony: time synchronisation (INSTALL enables chronyd once per system)
depends="abyss-st abyss-dmenu abyss-slock>=1.7_2 nsxiv feh xss-lock adwaita-icon-theme xmenu xdotool chrony"
short_desc="Abyss desktop menus, software installer, and hardware setup tools"
maintainer="MrZaKaRiA <67268825+MrZaKaRiA@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/MrZaKaRiA/AbyssLinux"
do_build() {
	$CC $CFLAGS -o abyss-key-capture ${FILESDIR}/abyss-key-capture.c $LDFLAGS -lX11
}
do_install() {
	vmkdir usr/bin
	vinstall abyss-key-capture 755 usr/bin
	for f in ${FILESDIR}/bin/*; do
		[ -f "$f" ] || continue
		vinstall "$f" 755 usr/bin
	done
	# Writes the /usr/local/bin wrappers (INSTALL, and the ISO build)
	vinstall ${FILESDIR}/local-bin-wrappers 755 usr/libexec/abyss-desktop
	vinstall ${FILESDIR}/abyss-images.desktop 644 usr/share/applications
	# Interactive shell helpers (update, upgrade, install, ...). Not a
	# conf_file on purpose: it is code that every update must be able to fix;
	# local changes belong in ~/.bashrc. INSTALL migrates the old copy.
	vinstall ${FILESDIR}/zz-abyss-cli.sh 644 etc/profile.d

	vmkdir usr/share/abyss/rofi
	vinstall ${FILESDIR}/rofi-config.rasi 644 usr/share/abyss/rofi config.rasi
	# chronyd reads it through /etc/sv/chronyd/conf (written by INSTALL);
	# it includes Void's /etc/chrony.conf and lets chronyd step the clock
	vinstall ${FILESDIR}/chrony.conf 644 usr/share/abyss
}

