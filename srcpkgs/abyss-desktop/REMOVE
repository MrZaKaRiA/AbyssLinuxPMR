#!/bin/sh
case "$ACTION" in
post)
	# Package removed (not updated): drop every /usr/local/bin wrapper INSTALL
	# wrote (found by its marker, so no command list can miss one) and put
	# back a local file INSTALL had set aside.
	if [ "$UPDATE" != yes ]; then
		for wrapper in usr/local/bin/*; do
			[ -f "$wrapper" ] && grep -q 'managed by abyss-desktop' "$wrapper" 2>/dev/null || continue
			if [ -e "$wrapper.abyss-backup" ]; then
				mv -f "$wrapper.abyss-backup" "$wrapper"
			else
				rm -f "$wrapper"
			fi
		done
	fi
	;;
esac
