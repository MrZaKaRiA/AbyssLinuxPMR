#!/bin/sh
# Keep historical /usr/local/bin paths working for Abyss desktop bindings.
case "$ACTION" in
post)
	mkdir -p usr/local/bin
	for cmd in abyss-apps abyss-control-center abyss-display abyss-display-setup \
		abyss-installer abyss-keyboard abyss-key-capture abyss-launcher abyss-power abyss-priv \
		abyss-session abyss-setup abyss-shortcuts abyss-shortcut-editor abyss-screenshot abyss-software abyss-welcome \
		dmenu-ssh dwm-statusbar; do
		wrapper="usr/local/bin/$cmd"
		if [ -e "$wrapper" ] && ! grep -q 'managed by abyss-desktop' "$wrapper"; then
			[ -e "$wrapper.abyss-backup" ] || cp -p "$wrapper" "$wrapper.abyss-backup"
		fi
		# Replace the directory entry instead of truncating it: older images can
		# contain linked files, where writing through one path changes another.
		tmp=$(mktemp "usr/local/bin/.abyss-wrapper.XXXXXX") || exit 1
		cat > "$tmp" <<EOF
#!/bin/sh
# managed by abyss-desktop; keep the historical Abyss command path
exec /usr/bin/$cmd "\$@"
EOF
		chmod 0755 "$tmp" || exit 1
		mv -f "$tmp" "$wrapper" || exit 1
	done
	;;
esac
