#!/bin/sh
# Keep historical /usr/local/bin paths working for Abyss desktop bindings.
case "$ACTION" in
pre)
	# Images up to 27.3.3 copied the Abyss commands into /usr/local/bin. A
	# copy identical to the /usr/bin file of the package being replaced is
	# not a local edit: note it, so post makes it a wrapper without keeping
	# an .abyss-backup of it.
	if [ -d usr/local/bin ] && mkdir -p var/lib/abyss-desktop; then
		for f in usr/local/bin/*; do
			[ -f "$f" ] && [ ! -L "$f" ] || continue
			grep -q 'managed by abyss-desktop' "$f" && continue
			cmp -s "$f" "usr/bin/${f##*/}" 2>/dev/null && printf '%s\n' "${f##*/}"
		done > var/lib/abyss-desktop/.local-bin-copies
	fi
	;;
post)
	# Keep the historical /usr/local/bin paths working: each Abyss command
	# there becomes a wrapper for the packaged /usr/bin one. The list and the
	# wrapper text live in this helper; the ISO build runs it too.
	sh usr/libexec/abyss-desktop/local-bin-wrappers || exit 1

	# Let root use doas on systems installed before the image shipped the rule:
	# root is not in wheel, so `doas <cmd>` (the update/upgrade/u/i/r shell
	# shortcuts in root's copy of the skel rc files) was denied in a root shell.
	# Safe: root already holds every privilege doas grants. Only ever appends
	# this one rule, once, to an existing config with no root rule (rewritten root:root 0400, the
	# mode doas documents); no other rule is touched, and any failure leaves the
	# config as it was.
	conf=etc/doas.conf
	if [ -f "$conf" ] && ! grep -Eq '^[[:space:]]*(permit|deny)([[:space:]]+(nopass|persist|keepenv|nolog|setenv[[:space:]]*\{[^}]*\}))*[[:space:]]+root([[:space:]]|$)' "$conf"; then
		tmp=$(mktemp etc/.doas.conf.XXXXXX) && cat "$conf" > "$tmp" && {
			[ -z "$(tail -c 1 "$tmp")" ] || echo >> "$tmp"
			printf '%s\n' '' \
				'# root may use doas too (added by abyss-desktop); keep this last' \
				'permit nopass root' >> "$tmp"
		} && chmod 0400 "$tmp" && {
			# doas wants root:root; only a non-root rootdir install cannot set it
			chown 0:0 "$tmp" 2>/dev/null || [ "$(id -u)" -ne 0 ]
		} && {
			! command -v doas >/dev/null 2>&1 || doas -C "$tmp" >/dev/null 2>&1
		} && mv -f "$tmp" "$conf" || {
			[ -z "$tmp" ] || rm -f "$tmp"
			echo "abyss-desktop: /etc/doas.conf left unchanged (could not add the root rule)" >&2
		}
	fi

	# Shell helpers moved from the image-only /etc/profile.d/99-void-dev-cli.sh
	# to the packaged /etc/profile.d/zz-abyss-cli.sh, so updates now reach them.
	# ~/.bashrc and /root/.bashrc of existing installs load the old name, so
	# an untouched old copy (sha256 of every version an Abyss image shipped)
	# becomes a stub that loads the packaged file. A locally edited copy is
	# kept as it is; zz- loads after it in login shells.
	old=etc/profile.d/99-void-dev-cli.sh
	if [ -f "$old" ] && [ ! -L "$old" ]; then
		if grep -q '^# managed by abyss-desktop' "$old"; then
			old_kind=stub
		else
			case "$(sha256sum < "$old" 2>/dev/null)" in
			71b4c0585ab19cf841ac77fee8e0d5c4074cb7d00b263221392c856be12f8566*|\
			4231d3003e7615c015765a30705901f49578c641dea4e1c6bceb4780191ea718*|\
			be7a15dfe2f05cc40e45c61f38436ab00cd733415d4280fff007e2c3a56d73f1*|\
			42eac4ad44a477b97efb2e2c581e023d158bbfa438d0be1d4a55f5bafcb662c8*)
				old_kind=shipped ;;
			*)	old_kind=edited ;;
			esac
		fi
		if [ "$old_kind" = edited ]; then
			echo "abyss-desktop: kept your edited /etc/profile.d/99-void-dev-cli.sh; the updated shell helpers are in /etc/profile.d/zz-abyss-cli.sh" >&2
		else
			tmp=$(mktemp etc/profile.d/.abyss-cli.XXXXXX) && cat > "$tmp" <<'EOF' &&
# managed by abyss-desktop: the Abyss shell helpers (update, upgrade,
# install, ...) moved to /etc/profile.d/zz-abyss-cli.sh, which package
# updates keep current. This stub stays because ~/.bashrc loads this name.
[ -r /etc/profile.d/zz-abyss-cli.sh ] && . /etc/profile.d/zz-abyss-cli.sh
EOF
			chmod 0644 "$tmp" && mv -f "$tmp" "$old" || {
				[ -z "$tmp" ] || rm -f "$tmp"
				echo "abyss-desktop: could not update /etc/profile.d/99-void-dev-cli.sh" >&2
			}
		fi
	fi

	# Images up to 27.3.4 kept the live ISO's /usr/local/bin/void-installer
	# link on the installed system, where the installer it points to is
	# removed. Remove only that dangling link; on the live ISO (installer
	# present), or a link or file of the user's own, nothing changes. The
	# target is checked inside the system root (xbps may run with -r).
	vi=usr/local/bin/void-installer
	if [ -L "$vi" ] && [ "$(readlink "$vi")" = /usr/bin/void-installer ] &&
		[ ! -e usr/bin/void-installer ] && [ ! -L usr/bin/void-installer ]; then
		rm -f "$vi"
	fi

	# elogind: stop runit from starting it. D-Bus starts elogind on demand
	# (org.freedesktop.login1.service from the elogind package) as soon as
	# LightDM, polkit or NetworkManager ask for it, which happens before
	# runit's elogind service passes its `sv check dbus`. runit then retried
	# every second forever ("elogind is already running as PID N" in dmesg).
	# Done once per system, and only for the stock link: a link the user makes
	# again later is left alone. A runit-owned elogind that is up right now is
	# not stopped under a running desktop; the next update tries again.
	stamp=var/lib/abyss-desktop/elogind-dbus-activated
	link=etc/runit/runsvdir/default/elogind
	if [ ! -e "$stamp" ]; then
		done_elogind=yes
		case "$(readlink "$link" 2>/dev/null)" in
		/etc/sv/elogind|/etc/sv/elogind/)
			# runsv writes its child's pid; in the restart loop that child
			# lives for milliseconds, a real runit-owned daemon stays.
			pid=$(cat etc/sv/elogind/supervise/pid 2>/dev/null)
			if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = elogind ]; then
				sleep 1
				[ "$(cat etc/sv/elogind/supervise/pid 2>/dev/null)" != "$pid" ] || done_elogind=
			fi
			if [ -n "$done_elogind" ] && rm -f "$link" && [ ! -L "$link" ]; then
				echo "abyss-desktop: disabled the elogind runit service; D-Bus starts elogind when it is needed (to undo: ln -s /etc/sv/elogind /var/service/)" >&2
			else
				done_elogind=
			fi
			;;
		esac
		[ -z "$done_elogind" ] || { mkdir -p "${stamp%/*}" && : > "$stamp"; }
	fi

	# Time synchronisation: chrony (a dependency) keeps the clock right. A
	# wrong clock breaks TLS and package signature checks, and a virtual
	# machine's clock falls behind whenever the host sleeps. Enabled once per
	# system and only when no other NTP client is enabled; a user who
	# disables it later keeps it disabled. /etc/sv/chronyd/conf (kept if it
	# exists) points chronyd at /usr/share/abyss/chrony.conf: Void's
	# /etc/chrony.conf plus stepping the clock after a host sleep.
	stamp=var/lib/abyss-desktop/time-sync-enabled
	if [ ! -e "$stamp" ] && [ -f etc/sv/chronyd/run ]; then
		other=
		for sv in chronyd ntpd openntpd isc-ntpd ntpd-rs busybox-ntpd sntpd; do
			for l in etc/runit/runsvdir/*/"$sv"; do
				if [ -e "$l" ] || [ -L "$l" ]; then other=$sv; fi
			done
		done
		done_ntp=yes
		if [ -n "$other" ]; then
			echo "abyss-desktop: time synchronisation left to the enabled $other service" >&2
		else
			[ -e etc/sv/chronyd/conf ] || cat > etc/sv/chronyd/conf <<'EOF'
# managed by abyss-desktop: chronyd reads /usr/share/abyss/chrony.conf, which
# includes /etc/chrony.conf (change settings there) and lets chronyd step
# the clock after a virtual machine's host slept. Delete this file to use
# /etc/chrony.conf alone.
[ -r /usr/share/abyss/chrony.conf ] && OPTS="-f /usr/share/abyss/chrony.conf"
EOF
			mkdir -p etc/runit/runsvdir/default
			if ln -s /etc/sv/chronyd etc/runit/runsvdir/default/chronyd; then
				echo "abyss-desktop: enabled chronyd (time synchronisation; to undo: rm /var/service/chronyd)" >&2
			else
				done_ntp=
			fi
		fi
		[ -z "$done_ntp" ] || { mkdir -p "${stamp%/*}" && : > "$stamp"; }
	fi

	# Weekly TRIM (abyss-fstrim, shipped here): tells the disk which blocks
	# are free, so an SSD stays fast and a virtual machine's disk image
	# shrinks after files are deleted. Enabled once per system; a user who
	# disables it later keeps it disabled.
	stamp=var/lib/abyss-desktop/fstrim-enabled
	if [ ! -e "$stamp" ] && [ -f etc/sv/abyss-fstrim/run ]; then
		link=etc/runit/runsvdir/default/abyss-fstrim
		mkdir -p etc/runit/runsvdir/default
		done_trim=yes
		if [ ! -e "$link" ] && [ ! -L "$link" ]; then
			if ln -s /etc/sv/abyss-fstrim "$link"; then
				echo "abyss-desktop: enabled abyss-fstrim (weekly TRIM; to undo: rm /var/service/abyss-fstrim)" >&2
			else
				done_trim=
			fi
		fi
		[ -z "$done_trim" ] || { mkdir -p "${stamp%/*}" && : > "$stamp"; }
	fi

	# System log (socklog-void, a dependency): keeps kernel and service
	# messages in /var/log/socklog, so a freeze or crash that ends with a
	# forced restart leaves its trace (hung tasks, out of memory, disk or
	# graphics errors) for the next boot; dmesg alone is lost with the boot.
	# svlogd rotates the files, so the log stays small. socklog-unix collects
	# /dev/log, nanoklogd feeds it the kernel log. Enabled once per system and
	# only when no other system logger is enabled; a user who disables it
	# later keeps it disabled. Read it as root: svlogtail, or
	# /var/log/socklog/kernel/current and /var/log/socklog/everything/current.
	stamp=var/lib/abyss-desktop/syslog-enabled
	if [ ! -e "$stamp" ] && [ -f etc/sv/socklog-unix/run ] && [ -f etc/sv/nanoklogd/run ]; then
		other=
		for sv in socklog-unix rsyslogd syslog-ng metalog sysklogd busybox-syslogd; do
			for l in etc/runit/runsvdir/*/"$sv"; do
				if [ -e "$l" ] || [ -L "$l" ]; then other=$sv; fi
			done
		done
		done_log=yes
		if [ -n "$other" ]; then
			echo "abyss-desktop: system log left to the enabled $other service" >&2
		else
			mkdir -p etc/runit/runsvdir/default
			for sv in socklog-unix nanoklogd; do
				link=etc/runit/runsvdir/default/$sv
				[ -e "$link" ] || [ -L "$link" ] || ln -s "/etc/sv/$sv" "$link" || done_log=
			done
			if [ -n "$done_log" ]; then
				echo "abyss-desktop: enabled the system log in /var/log/socklog (socklog-unix, nanoklogd; to undo: rm /var/service/socklog-unix /var/service/nanoklogd)" >&2
			fi
		fi
		[ -z "$done_log" ] || { mkdir -p "${stamp%/*}" && : > "$stamp"; }
	fi
	;;
esac
