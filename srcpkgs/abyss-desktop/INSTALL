#!/bin/sh
# Keep historical /usr/local/bin paths working for Abyss desktop bindings.
case "$ACTION" in
post)
	mkdir -p usr/local/bin
	for cmd in abyss-apps abyss-cursor abyss-control-center abyss-display abyss-display-setup abyss-file-chooser-init \
		abyss-installer abyss-keyboard abyss-key-capture abyss-launcher abyss-power abyss-priv \
		abyss-session abyss-record abyss-rofi-repair abyss-thunar-init abyss-setup abyss-shortcuts abyss-shortcut-editor abyss-screenshot abyss-software abyss-wallpaper abyss-wallpapers abyss-welcome \
		dmenu-ssh dwm-statusbar; do
		wrapper="usr/local/bin/$cmd"
		if [ -e "$wrapper" ] && ! grep -q 'managed by abyss-desktop' "$wrapper"; then
			[ -e "$wrapper.abyss-backup" ] || cp -p "$wrapper" "$wrapper.abyss-backup"
		fi
		# Replace the directory entry instead of truncating it: older images can
		# contain linked files, where writing through one path changes another.
		tmp=$(mktemp "usr/local/bin/.abyss-wrapper.XXXXXX") || exit 1
		cat > "$tmp" <<EOF
#!/bin/sh
# managed by abyss-desktop; keep the historical Abyss command path
exec /usr/bin/$cmd "\$@"
EOF
		chmod 0755 "$tmp" || exit 1
		mv -f "$tmp" "$wrapper" || exit 1
	done

	# Let root use doas on systems installed before the image shipped the rule:
	# root is not in wheel, so `doas <cmd>` (the update/upgrade/u/i/r shell
	# shortcuts in root's copy of the skel rc files) was denied in a root shell.
	# Safe: root already holds every privilege doas grants. Only ever appends
	# this one rule, once, to an existing config with no root rule (rewritten root:root 0400, the
	# mode doas documents); no other rule is touched, and any failure leaves the
	# config as it was.
	conf=etc/doas.conf
	if [ -f "$conf" ] && ! grep -Eq '^[[:space:]]*(permit|deny)([[:space:]]+(nopass|persist|keepenv|nolog|setenv[[:space:]]*\{[^}]*\}))*[[:space:]]+root([[:space:]]|$)' "$conf"; then
		tmp=$(mktemp etc/.doas.conf.XXXXXX) && cat "$conf" > "$tmp" && {
			[ -z "$(tail -c 1 "$tmp")" ] || echo >> "$tmp"
			printf '%s\n' '' \
				'# root may use doas too (added by abyss-desktop); keep this last' \
				'permit nopass root' >> "$tmp"
		} && chmod 0400 "$tmp" && {
			# doas wants root:root; only a non-root rootdir install cannot set it
			chown 0:0 "$tmp" 2>/dev/null || [ "$(id -u)" -ne 0 ]
		} && {
			! command -v doas >/dev/null 2>&1 || doas -C "$tmp" >/dev/null 2>&1
		} && mv -f "$tmp" "$conf" || {
			[ -z "$tmp" ] || rm -f "$tmp"
			echo "abyss-desktop: /etc/doas.conf left unchanged (could not add the root rule)" >&2
		}
	fi

	# Shell helpers moved from the image-only /etc/profile.d/99-void-dev-cli.sh
	# to the packaged /etc/profile.d/zz-abyss-cli.sh, so updates now reach them.
	# ~/.bashrc and /root/.bashrc of existing installs load the old name, so
	# an untouched old copy (sha256 of every version an Abyss image shipped)
	# becomes a stub that loads the packaged file. A locally edited copy is
	# kept as it is; zz- loads after it in login shells.
	old=etc/profile.d/99-void-dev-cli.sh
	if [ -f "$old" ] && [ ! -L "$old" ]; then
		if grep -q '^# managed by abyss-desktop' "$old"; then
			old_kind=stub
		else
			case "$(sha256sum < "$old" 2>/dev/null)" in
			71b4c0585ab19cf841ac77fee8e0d5c4074cb7d00b263221392c856be12f8566*|\
			4231d3003e7615c015765a30705901f49578c641dea4e1c6bceb4780191ea718*|\
			be7a15dfe2f05cc40e45c61f38436ab00cd733415d4280fff007e2c3a56d73f1*|\
			42eac4ad44a477b97efb2e2c581e023d158bbfa438d0be1d4a55f5bafcb662c8*)
				old_kind=shipped ;;
			*)	old_kind=edited ;;
			esac
		fi
		if [ "$old_kind" = edited ]; then
			echo "abyss-desktop: kept your edited /etc/profile.d/99-void-dev-cli.sh; the updated shell helpers are in /etc/profile.d/zz-abyss-cli.sh" >&2
		else
			tmp=$(mktemp etc/profile.d/.abyss-cli.XXXXXX) && cat > "$tmp" <<'EOF' &&
# managed by abyss-desktop: the Abyss shell helpers (update, upgrade,
# install, ...) moved to /etc/profile.d/zz-abyss-cli.sh, which package
# updates keep current. This stub stays because ~/.bashrc loads this name.
[ -r /etc/profile.d/zz-abyss-cli.sh ] && . /etc/profile.d/zz-abyss-cli.sh
EOF
			chmod 0644 "$tmp" && mv -f "$tmp" "$old" || {
				[ -z "$tmp" ] || rm -f "$tmp"
				echo "abyss-desktop: could not update /etc/profile.d/99-void-dev-cli.sh" >&2
			}
		fi
	fi

	# elogind: stop runit from starting it. D-Bus starts elogind on demand
	# (org.freedesktop.login1.service from the elogind package) as soon as
	# LightDM, polkit or NetworkManager ask for it, which happens before
	# runit's elogind service passes its `sv check dbus`. runit then retried
	# every second forever ("elogind is already running as PID N" in dmesg).
	# Done once per system, and only for the stock link: a link the user makes
	# again later is left alone. A runit-owned elogind that is up right now is
	# not stopped under a running desktop; the next update tries again.
	stamp=var/lib/abyss-desktop/elogind-dbus-activated
	link=etc/runit/runsvdir/default/elogind
	if [ ! -e "$stamp" ]; then
		done_elogind=yes
		case "$(readlink "$link" 2>/dev/null)" in
		/etc/sv/elogind|/etc/sv/elogind/)
			# runsv writes its child's pid; in the restart loop that child
			# lives for milliseconds, a real runit-owned daemon stays.
			pid=$(cat etc/sv/elogind/supervise/pid 2>/dev/null)
			if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = elogind ]; then
				sleep 1
				[ "$(cat etc/sv/elogind/supervise/pid 2>/dev/null)" != "$pid" ] || done_elogind=
			fi
			if [ -n "$done_elogind" ] && rm -f "$link" && [ ! -L "$link" ]; then
				echo "abyss-desktop: disabled the elogind runit service; D-Bus starts elogind when it is needed (to undo: ln -s /etc/sv/elogind /var/service/)" >&2
			else
				done_elogind=
			fi
			;;
		esac
		[ -z "$done_elogind" ] || { mkdir -p "${stamp%/*}" && : > "$stamp"; }
	fi
	;;
esac
