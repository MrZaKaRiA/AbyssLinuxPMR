# Template file for 'abyss-wmname'
# wmname 0.1 + upstream git 1114a83 (no Abyss changes); used by
# ~/.xinitrc ("wmname LG3D") so Java GUI toolkits render under dwm
pkgname=abyss-wmname
version=0.1
revision=1
_gitrev=1114a83
wrksrc="wmname-${version}"
build_style=gnu-makefile
makedepends="libX11-devel"
short_desc="Change the window manager name (Abyss Linux build)"
maintainer="MrZaKaRiA <67268825+MrZaKaRiA@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/MrZaKaRiA/AbyssLinux"
distfiles="https://dl.suckless.org/tools/wmname-${version}.tar.gz"
checksum=559ad188b2913167dcbb37ecfbb7ed474a7ec4bbcb0129d8d5d08cb9208d02c5
conflicts="wmname>=0"

do_build() {
	sed -e '/strip/d' -i Makefile
	make CC=$CC INCS=-I. LDFLAGS="-lX11 $LDFLAGS" CFLAGS="$CFLAGS -DVERSION=\\\"$version\\\""
}

post_install() {
	vlicense LICENSE
}
