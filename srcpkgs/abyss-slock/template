# Template file for 'abyss-slock'
# slock 1.7 + upstream git 65cb721 + Abyss config (patches/)
pkgname=abyss-slock
version=1.7
revision=1
_gitrev=65cb721
wrksrc="slock-${version}"
hostmakedepends="pkg-config"
makedepends="libXrandr-devel"
short_desc="Simple screen locker for X (Abyss Linux build)"
maintainer="MrZaKaRiA <67268825+MrZaKaRiA@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/MrZaKaRiA/AbyssLinux"
distfiles="https://dl.suckless.org/tools/slock-${version}.tar.gz"
checksum=99711e6b419b221ae9fc3e9c8f31e6b168db51154278996f3d02ce65cc198301
conflicts="slock>=0"

if [ "$XBPS_TARGET_LIBC" = "glibc" ]; then
	makedepends+=" libxcrypt-devel"
fi

do_build() {
	sed -i 's/CPPFLAGS =/CPPFLAGS +=/g' config.mk
	sed -i 's/CFLAGS =/CFLAGS +=/g' config.mk
	sed -i 's/LDFLAGS =/LDFLAGS +=/g' config.mk
	make CC=$CC INCS="-I." LIBS="-lX11 -lXext -lcrypt -lXrandr" ${makejobs}
}

do_install() {
	make PREFIX=/usr DESTDIR=$DESTDIR install
	vlicense LICENSE
}
